# Copy thành .env (đã bị .gitignore bỏ qua). Không commit file .env.

# --- Dense: vector store Day 6 (PostgreSQL 16 + pgvector) --------------
DAY6_DSN=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab
# Bảng/cột để trống thì tự dò; bảng Day 6 có cột strategy nên phải chọn strategy
DAY6_CHUNK_TABLE=chunks
DAY6_STRATEGY=B
DAY6_EMBED_COLUMN=
DAY6_ID_COLUMN=
DAY6_TEXT_COLUMN=
DAY6_SOURCE_ID_COLUMN=
DAY6_SOURCE_COLUMN=
DAY6_PAGE_COLUMN=
DAY6_METADATA_COLUMN=

# --- Embedding model: phải trùng model Day 6 đã index ---
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=64
# Chỉ dùng khi chọn provider OpenAI-compatible
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_API_KEY=

# --- Agent model (chat completions, OpenAI-compatible) ---
LLM_MODEL=gpt-4o-mini
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_TEMPERATURE=0

# --- Retrieval defaults ---
TOP_K=3
CONTEXT_BUDGET=800
RRF_K=60
HYBRID_CANDIDATE_K=10
HYBRID_DENSE_WEIGHT=1.0
HYBRID_LEXICAL_WEIGHT=1.0
BM25_K1=1.5
BM25_B=0.75
BM25_FOLD_ACCENTS=true

# --- Tái tạo chunk offline từ PDF Day 6 (khi PostgreSQL không chạy) ---
DAY6_LAST_PAGE=35
